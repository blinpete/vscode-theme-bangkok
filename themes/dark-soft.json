        "foreground": "#ababab"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ababab"
      }
    },
    {
      "scope": "markup.raw",
      "settings": {
        "foreground": "#d8897b"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
